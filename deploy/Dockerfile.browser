FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    CRAWLER_BROWSER_CHANNEL=chromium CRAWLER_BROWSER_FALLBACK=true
WORKDIR /app
COPY requirements-lock.txt requirements-browser-lock.txt pyproject.toml ./
COPY src ./src
RUN python -m pip install --no-cache-dir -r requirements-lock.txt -r requirements-browser-lock.txt \
    && python -m pip install --no-cache-dir --no-deps . \
    && python -m playwright install --with-deps chromium \
    && useradd --uid 10001 --create-home crawler \
    && mkdir -p /app/var && chown crawler:crawler /app/var
USER 10001:10001
CMD ["crawler", "worker"]
