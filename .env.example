CRAWLER_DATABASE_URL=sqlite:///var/crawler.db
CRAWLER_CONTENT_ROOT=var/content
# Optional, explicitly authorized GCS object prefix (otherwise local files).
# CRAWLER_OBJECT_URI=gs://APPROVED_BUCKET/private-crawler-content
# Set a randomly generated value of at least 24 characters before starting the API.
CRAWLER_API_KEY=
CRAWLER_WORKERS=4
CRAWLER_MAX_BYTES=10485760
CRAWLER_MAX_WIRE_BYTES=5242880
CRAWLER_REQUEST_TIMEOUT=20
CRAWLER_ORIGIN_DELAY=1
CRAWLER_LEASE_SECONDS=120
CRAWLER_MAX_ATTEMPTS=3
CRAWLER_MAX_PENDING_JOBS=10000
CRAWLER_API_REQUESTS_PER_MINUTE=60
# Optional JS-shell rendering in workers; never used to retry denied/error pages.
CRAWLER_BROWSER_FALLBACK=false
# Use an already installed Windows browser; Linux browser image uses chromium.
CRAWLER_BROWSER_CHANNEL=msedge
CRAWLER_BROWSER_MAX_REQUESTS=16
# Operator-only read-only MySQL DSN and analytics credentials belong in secret storage.
# Never enable cloud tests or configure existing organizational credentials by default.
# No local infrastructure or cloud credentials are configured by default.

